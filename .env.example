# Copy to .env.local and fill values locally. Never commit .env.local.
# Never expose server secrets with NEXT_PUBLIC_. Never use production credentials locally.
# Values below are placeholders; see docs/phase-2-setup.md for this project's URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SITE_URL=http://localhost:3000
# Keep disabled until the development database and email configuration are ready.
AUTH_ENABLED=false
# Keep indexing disabled until public-launch approval.
ALLOW_INDEXING=false
# Phase A: database catalogue can be enabled independently of authentication.
CATALOGUE_ENABLED=false
# Keep sending disabled until owner configures and verifies the Development provider.
NOTIFICATIONS_ENABLED=false
EMAIL_DELIVERY_ENABLED=false
# SERVER ONLY. Use the DEVELOPMENT project's secret key, never a production key.
SUPABASE_SECRET_KEY=YOUR_DEVELOPMENT_SECRET_KEY
RESEND_API_KEY=YOUR_RESEND_API_KEY
NOTIFICATION_FROM_EMAIL=YOUR_VERIFIED_SENDER_ADDRESS
NOTIFICATION_ENCRYPTION_KEY=YOUR_64_HEX_CHARACTER_KEY
NOTIFICATION_WORKER_SECRET=YOUR_RANDOM_WORKER_SECRET
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# Phase 4: closed until reviewed policies, email confirmation and Development migrations are verified.
REGISTRATION_ENABLED=false
SUPPORT_EMAIL=biosciencemastery@gmail.com
